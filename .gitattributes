# Fichiers C/C++
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf

# JSON et fichiers de configuration
*.json text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Scripts shell ou batch
*.sh text eol=lf
*.bat text eol=crlf

# Images et fichiers binaires → ne pas toucher aux fins de ligne
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.bmp binary
*.gif binary

# Autres binaires
*.exe binary
*.dll binary
*.lib binary
*.a binary
*.so binary
